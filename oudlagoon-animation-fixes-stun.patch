From 4f8b30bc0e9d988fef607477d5ba2157b8a392a8 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 15 Nov 2026 15:36:27 +0500
Subject: [PATCH] Unify Hit suppression for players and NPCs; fix false
 Common.Attack warning in Validate

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01DLMaP4V7LcPHCrxoi4fJm8
---
 .../Shared/Config/CombatAnimationConfig.lua   | 29 +++++++++++++++----
 .../Services/CombatService.lua                |  6 ++++
 .../Services/NPCCombatAnimationService.lua    |  2 +-
 .../CombatAnimationController.client.lua      | 15 +++++++---
 4 files changed, 41 insertions(+), 11 deletions(-)

diff --git a/src/ReplicatedStorage/Shared/Config/CombatAnimationConfig.lua b/src/ReplicatedStorage/Shared/Config/CombatAnimationConfig.lua
index fa9c5b9..7b6f18d 100644
--- a/src/ReplicatedStorage/Shared/Config/CombatAnimationConfig.lua
+++ b/src/ReplicatedStorage/Shared/Config/CombatAnimationConfig.lua
@@ -81,11 +81,11 @@ CombatAnimationConfig.Common = {
     BlockLoop = "rbxassetid://132713008662757",
     BlockHit = "rbxassetid://0",
     Parry = "rbxassetid://98950245815500",
-    Hit1 = "rbxassetid://138056454440264",
-    Hit2 = "rbxassetid://138056454440264",
-    Hit3 = "rbxassetid://138056454440264",
+    Hit1 = "rbxassetid://0",
+    Hit2 = "rbxassetid://0",
+    Hit3 = "rbxassetid://0",
 
-    Parried = "rbxassetid://138056454440264",
+    Parried = "rbxassetid://0",
     Stunned = "rbxassetid://86159934712814",
     Dodge = "rbxassetid://0",
 }
@@ -139,6 +139,12 @@ function CombatAnimationConfig.GetAnimationId(slot, weaponId)
     return nil
 end
 
+-- Единое правило для игроков и NPC: проигрывать ли реакцию Hit1..3, если в момент удара
+-- получатель находился в состоянии state (см. Settings.SuppressHitDuring).
+function CombatAnimationConfig.ShouldPlayHit(state)
+    return not CombatAnimationConfig.Settings.SuppressHitDuring[state]
+end
+
 -- Случайный слот реакции на урон среди НАЗНАЧЕННЫХ Hit1..3, не равный lastSlot
 -- (если вариантов больше одного). nil, если ни одна анимация не назначена.
 -- random - необязательная функция () -> число [0, 1) (для тестов); по умолчанию math.random.
@@ -199,8 +205,19 @@ function CombatAnimationConfig.Validate()
             add("Slots." .. slot, "has no boolean Looped")
         end
 
-        if CombatAnimationConfig.Common[slot] == nil then
-            add("Common has no entry for slot", slot, "(use \"rbxassetid://0\" as placeholder)")
+        -- Слот должен быть объявлен в Common либо хотя бы у одного оружия
+        -- (например, Attack лежит только в Weapons.Unarmed / Weapons.Sword)
+        local declared = CombatAnimationConfig.Common[slot] ~= nil
+
+        for _, animations in pairs(CombatAnimationConfig.Weapons) do
+            if animations[slot] ~= nil then
+                declared = true
+                break
+            end
+        end
+
+        if not declared then
+            add("slot", slot, "has no entry in Common or in any weapon (use \"rbxassetid://0\" as placeholder)")
         end
     end
 
diff --git a/src/ServerScriptService/Services/CombatService.lua b/src/ServerScriptService/Services/CombatService.lua
index a92d68e..15f04e2 100644
--- a/src/ServerScriptService/Services/CombatService.lua
+++ b/src/ServerScriptService/Services/CombatService.lua
@@ -363,6 +363,11 @@ function CombatService:RunActiveWindow(attack)
                 )
                 local victim = Players:GetPlayerFromCharacter(target.Model)
 
+                -- Состояние получателя В МОМЕНТ удара (до оглушения от этого удара).
+                -- Уходит клиенту: иначе сообщение о Stunned придёт раньше Received, и клиент
+                -- решил бы, что получатель уже оглушён, и подавил бы реакцию Hit.
+                local victimState = CombatStateService:GetState(target.Model)
+
                 -- Обычное попадание оглушает получателя.
                 if outcome.Result == CombatStates.DamageResults.Hit
                     and outcome.Damage > 0
@@ -410,6 +415,7 @@ function CombatService:RunActiveWindow(attack)
                     if victim then
                         feedback:FireClient(victim, {
                             Kind = "Received",
+                            VictimState = victimState,
                             Damage = outcome.Damage,
                             Result = outcome.Result,
                         })
diff --git a/src/ServerScriptService/Services/NPCCombatAnimationService.lua b/src/ServerScriptService/Services/NPCCombatAnimationService.lua
index c27ccef..186bc95 100644
--- a/src/ServerScriptService/Services/NPCCombatAnimationService.lua
+++ b/src/ServerScriptService/Services/NPCCombatAnimationService.lua
@@ -282,7 +282,7 @@ local function OnDamageApplied(character, outcome)
             PlayReaction(entry, "BlockHit", backToBlock)
         end
     elseif result == DamageResults.Hit then
-        if not Settings.SuppressHitDuring[state] then
+        if CombatAnimationConfig.ShouldPlayHit(state) then
             -- Свой вариант на каждый NPC: не повторяем предыдущий
             local slot = CombatAnimationConfig.PickHitSlot(CombatConfig.UnarmedId, entry.LastHitSlot)
 
diff --git a/src/StarterPlayer/StarterPlayerScripts/CombatAnimationController.client.lua b/src/StarterPlayer/StarterPlayerScripts/CombatAnimationController.client.lua
index e43233b..cf5d508 100644
--- a/src/StarterPlayer/StarterPlayerScripts/CombatAnimationController.client.lua
+++ b/src/StarterPlayer/StarterPlayerScripts/CombatAnimationController.client.lua
@@ -19,7 +19,8 @@
 -- Результат удара по своему персонажу (CombatFeedback, Kind = "Received"):
 --   Parried -> Parry заменяет блок, после неё снова включается BlockLoop;
 --   Blocked -> BlockHit накладывается поверх блока (блок не прерывается);
---   Hit     -> один из Hit1..3 (getRandomHitSlot, без повтора подряд) поверх текущей позы.
+--   Hit     -> один из Hit1..3 (getRandomHitSlot, без повтора подряд) поверх текущей позы,
+--              кроме состояний из Settings.SuppressHitDuring (то же правило, что у NPC).
 --
 -- Явные реакции (CombatFeedback, Kind = "Reaction"):
 --   Parried - мой удар парировали;
@@ -543,10 +544,16 @@ local function onFeedback(payload)
         end
 
     elseif payload.Result == DamageResults.Hit then
-        local hitSlot = getRandomHitSlot(weaponId)
+        -- То же правило, что у NPC (Settings.SuppressHitDuring). Берём состояние в момент
+        -- удара от сервера: к приходу Received currentState уже может быть Stunned от этого удара.
+        local stateAtHit = type(payload.VictimState) == "string" and payload.VictimState or currentState
 
-        if hitSlot then
-            playReaction(hitSlot, weaponId)
+        if CombatAnimationConfig.ShouldPlayHit(stateAtHit) then
+            local hitSlot = getRandomHitSlot(weaponId)
+
+            if hitSlot then
+                playReaction(hitSlot, weaponId)
+            end
         end
     end
 end
