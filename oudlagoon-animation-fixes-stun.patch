+-- ОГЛУШЕНИЕ ------------------------------------------------------------
+
+-- Оглушает персонажа (игрока или NPC) на duration секунд; nil = Stun.DefaultDuration.
+-- Длительность ограничена Stun.MaxDuration. Оглушение прерывает атаку, блок и уклонение.
+-- Повторный вызов во время оглушения только ПРОДЛЕВАЕТ его (если новый конец позже
+-- текущего); укорачивать оглушение нельзя.
+-- source - необязательный Instance источника (например, способность или атакующий), для событий.
+-- По успеху вызывает событие OnStunned и возвращает true, <длительность>;
+-- иначе false, <причина> (Dead, InvalidDuration, NotLonger).
+function CombatStateService:ApplyStun(character, duration, source)
+    local config = CombatStateConfig.Stun
+
+    if duration == nil then
+        duration = config.DefaultDuration
+    end
+
+    if not IsFiniteNumber(duration) or duration <= 0 then
+        return false, "InvalidDuration"
+    end
+
+    duration = math.min(duration, config.MaxDuration)
+
+    local record = GetRecord(character)
+    local now = os.clock()
+
+    if record.State == State.Stunned then
+        local newEndsAt = now + duration
+
+        if record.StateEndsAt and newEndsAt <= record.StateEndsAt then
+            return false, "NotLonger"
+        end
+
+        -- Новый TransitionId делает прежний таймер конца оглушения недействительным
+        transitionCounter += 1
+        record.TransitionId = transitionCounter
+        record.StateEndsAt = newEndsAt
+
+        self:Delay(character, duration, function()
+            self:Transition(character, State.Idle)
+        end)
+    else
+        local ok, reason = self:Transition(character, State.Stunned, {
+            Duration = duration,
+        })
+
+        if not ok then
+            return false, reason
+        end
+    end
+
+    Log(character.Name, "stunned for", duration)
+
+    Stunned.Fire(character, duration, source)
+
+    return true, duration
+end
+
 -- Dead: абсолютный приоритет, прерывает всё. Выход только через ResetCharacter.
